digraph Database {
  graph [rankdir=LR, bgcolor="#f8fafc", pad="0.45", nodesep="0.42", ranksep="1.1", splines=polyline, fontname="DejaVu Sans", fontsize=21, fontcolor="#0f172a", labelloc=t, label="Rinder · Main database relationships", dpi=144];
  node [shape=plain, fontname="DejaVu Sans", fontsize=12];
  edge [fontname="DejaVu Sans", fontsize=10, fontcolor="#475569", color="#64748b", arrowsize=0.75, penwidth=1.35];
  users [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#dbeafe"><B><FONT COLOR="#0f172a">users</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">username</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">user_type</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR></TABLE>>];
  students [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#dbeafe"><B><FONT COLOR="#0f172a">students</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">user_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">student_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR></TABLE>>];
  professors [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#dbeafe"><B><FONT COLOR="#0f172a">professors</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">user_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK, FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">professor_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR></TABLE>>];
  research_projects [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#dcfce7"><B><FONT COLOR="#0f172a">research_projects</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">project_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">title</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR></TABLE>>];
  experiment_registrations [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#dcfce7"><B><FONT COLOR="#0f172a">experiment_registrations</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">registration_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">project_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">user_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">FK</FONT></TD></TR></TABLE>>];
  survey [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#ffedd5"><B><FONT COLOR="#0f172a">survey</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">survey_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">title</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">&#160;</FONT></TD></TR></TABLE>>];
  survey_questions [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#ffedd5"><B><FONT COLOR="#0f172a">survey_questions</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">question_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">survey_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">FK</FONT></TD></TR></TABLE>>];
  survey_responses [label=<<TABLE BORDER="1" COLOR="#cbd5e1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" BGCOLOR="white"><TR><TD COLSPAN="2" ALIGN="LEFT" BGCOLOR="#ffedd5"><B><FONT COLOR="#0f172a">survey_responses</FONT></B></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">response_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">PK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">survey_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">user_id</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">FK</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#334155">response_data</FONT></TD><TD ALIGN="RIGHT"><FONT COLOR="#64748b">JSON</FONT></TD></TR></TABLE>>];
  users -> students [label="1 → 0..1\nstudent profile"];
  users -> professors [label="1 → 0..1\nprofessor profile"];
  users -> experiment_registrations [label="1 → 0..many\nregistrations"];
  research_projects -> experiment_registrations [label="1 → 0..many\nregistrations"];
  survey -> survey_questions [label="1 → 0..many\nquestions"];
  survey -> survey_responses [label="1 → 0..many\nresponses"];
  users -> survey_responses [label="1 → 0..many\nresponses"];
  { rank=same; users; research_projects; survey; }
  { rank=same; students; professors; experiment_registrations; survey_questions; survey_responses; }
}
